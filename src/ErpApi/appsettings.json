{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Erp": {
    "ConnectionStringEnvVar": "ERP_DB",
    "Jwt": { "Issuer": "ErpApi", "Audience": "ErpClient", "ExpireMinutes": 480 },
    "Login": { "MaxFailures": 5, "LockMinutes": 15 }
  }
}
